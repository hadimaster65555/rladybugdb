#!/bin/sh
# Download and verify the pinned LadybugDB C library for Windows.

set -eu

LBUG_VERSION=$(tr -d '[:space:]' < tools/lbug_version)
ARCH_RAW=${R_ARCH:-$(uname -m)}
case "$ARCH_RAW" in
  */arm64|*/aarch64|arm64|aarch64) ARTIFACT="liblbug-windows-arm64.zip" ;;
  */x64|x64|x86_64|amd64|'') ARTIFACT="liblbug-windows-x86_64.zip" ;;
  *) echo "configure.win: ERROR: unsupported architecture ${ARCH_RAW}." >&2; exit 1 ;;
esac

EXPECTED_SHA=$(awk -v artifact="$ARTIFACT" '$1 == artifact { print $2 }' tools/lbug_checksums)
if [ -z "$EXPECTED_SHA" ]; then
  echo "configure.win: ERROR: no SHA-256 recorded for ${ARTIFACT}." >&2
  exit 1
fi
URL="https://github.com/LadybugDB/ladybug/releases/download/v${LBUG_VERSION}/${ARTIFACT}"
VENDOR_INC="$(pwd)/src/vendor/include"
VENDOR_LIB="$(pwd)/src/vendor/lib"
VERSION_MARKER="${VENDOR_LIB}/ladybugdb-version"
mkdir -p "$VENDOR_INC" "$VENDOR_LIB"

VENDORED_VERSION=""
if [ -f "$VERSION_MARKER" ]; then
  VENDORED_VERSION=$(tr -d '[:space:]' < "$VERSION_MARKER")
fi

if [ -f "$VENDOR_INC/lbug.h" ] && [ -f "$VENDOR_LIB/lbug_shared.dll" ] &&
   [ -f "$VENDOR_LIB/lbug_shared.lib" ] && [ "$VENDORED_VERSION" = "$LBUG_VERSION" ]; then
  echo "configure.win: using LadybugDB v${LBUG_VERSION} artifacts already in src/vendor."
else
  DOWNLOAD_DIR=$(mktemp -d)
  trap 'rm -rf "$DOWNLOAD_DIR"' EXIT HUP INT TERM
  ARCHIVE="${DOWNLOAD_DIR}/${ARTIFACT}"
  curl -fL --retry 3 --connect-timeout 30 --max-time 600 "$URL" -o "$ARCHIVE"

  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA=$(sha256sum "$ARCHIVE" | awk '{ print $1 }')
  else
    ACTUAL_SHA=$(shasum -a 256 "$ARCHIVE" | awk '{ print $1 }')
  fi
  if [ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]; then
    echo "configure.win: ERROR: SHA-256 mismatch for ${ARTIFACT}." >&2
    exit 1
  fi

  unzip -q "$ARCHIVE" -d "$DOWNLOAD_DIR"
  HEADER_SOURCE=$(find "$DOWNLOAD_DIR" -name lbug.h | head -n 1)
  DLL_SOURCE=$(find "$DOWNLOAD_DIR" -name lbug_shared.dll | head -n 1)
  IMPORT_SOURCE=$(find "$DOWNLOAD_DIR" -name lbug_shared.lib | head -n 1)
  if [ -z "$HEADER_SOURCE" ] || [ -z "$DLL_SOURCE" ] || [ -z "$IMPORT_SOURCE" ]; then
    echo "configure.win: ERROR: incomplete LadybugDB archive ${ARTIFACT}." >&2
    exit 1
  fi
  cp "$HEADER_SOURCE" "$VENDOR_INC/lbug.h"
  cp "$DLL_SOURCE" "$VENDOR_LIB/lbug_shared.dll"
  cp "$IMPORT_SOURCE" "$VENDOR_LIB/lbug_shared.lib"
  printf '%s\n' "$LBUG_VERSION" > "$VERSION_MARKER"
fi

if command -v gendef >/dev/null 2>&1 && command -v dlltool >/dev/null 2>&1; then
  (cd "$VENDOR_LIB" && gendef lbug_shared.dll > lbug_shared.def &&
    dlltool -d lbug_shared.def -D lbug_shared.dll -l liblbug.dll.a)
  LBUG_IMPORT="$VENDOR_LIB/liblbug.dll.a"
else
  LBUG_IMPORT="$VENDOR_LIB/lbug_shared.lib"
fi

sed -e "s|@VENDOR_INC@|${VENDOR_INC}|g" \
    -e "s|@LBUG_IMPORT@|${LBUG_IMPORT}|g" \
    src/Makevars.win.in > src/Makevars.win
echo "configure.win: wrote src/Makevars.win."
