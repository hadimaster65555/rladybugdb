@@ -1,5 +1,6 @@
 #pragma once
 
+#include <atomic>
 #include <cstdint>
 #include <exception>
 #include <string>
@@ -13,6 +14,20 @@ time_t convertTmToTime(struct tm tm);
 int32_t convertTimeToTm(time_t time, struct tm* out_tm);
 #endif
 
+// Atomically takes a C API handle pointer, leaving nullptr behind, so a handle
+// destroyed twice is released only once. std::atomic_ref needs libc++ 19 or
+// newer; older libc++ releases (for example macOS SDKs before 15.4) use the
+// equivalent GCC/Clang builtin.
+inline void* exchangeHandleWithNull(void*& handle) {
+#if defined(__cpp_lib_atomic_ref)
+    return std::atomic_ref<void*>(handle).exchange(nullptr);
+#elif defined(__GNUC__) || defined(__clang__)
+    return __atomic_exchange_n(&handle, nullptr, __ATOMIC_SEQ_CST);
+#else
+#error "exchangeHandleWithNull requires std::atomic_ref or GCC/Clang atomic builtins"
+#endif
+}
+
 void setLastCAPIErrorMessage(const std::string& message);
 
 void clearLastCAPIErrorMessage();
diff --git a/src/include/common/string_format.h b/src/include/common/string_format.h
new file mode 100644
index 0000000..985961f
--- /dev/null
+++ b/src/include/common/string_format.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// Formatting entry point for LadybugDB sources in the rladybugdb CRAN build.
+// tools/vendor.R rewrites upstream std::format calls to stringFormat. By
+// default this forwards to std::format. Toolchains whose C++ library cannot
+// provide std::format for the deployment target (for example Apple clang 14,
+// or macOS targets older than 13.3) build with LBUG_FMT_FALLBACK, which uses
+// the {fmt} library bundled with spdlog. Both keep compile-time checking of
+// format strings.
+
+#include <string>
+#include <utility>
+
+#ifdef LBUG_FMT_FALLBACK
+#ifndef FMT_HEADER_ONLY
+#define FMT_HEADER_ONLY
+#endif
+#include "spdlog/fmt/bundled/format.h"
+#else
+#include <format>
+#endif
+
+namespace lbug {
+namespace common {
+
+#ifdef LBUG_FMT_FALLBACK
+template<typename... Args>
+inline std::string stringFormat(::fmt::format_string<Args...> formatString, Args&&... args) {
+    return ::fmt::format(formatString, std::forward<Args>(args)...);
+}
+#else
+template<typename... Args>
+inline std::string stringFormat(std::format_string<Args...> formatString, Args&&... args) {
+    return std::format(formatString, std::forward<Args>(args)...);
+}
+#endif
+
+} // namespace common
+} // namespace lbug
