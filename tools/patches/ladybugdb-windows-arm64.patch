diff --git a/third_party/fast_float/include/fast_float.h b/third_party/fast_float/include/fast_float.h
index d13884e..2dcc397 100644
--- a/third_party/fast_float/include/fast_float.h
+++ b/third_party/fast_float/include/fast_float.h
@@ -242,8 +242,10 @@ fastfloat_really_inline uint64_t _umul128(uint64_t ab, uint64_t cd,
 fastfloat_really_inline value128 full_multiplication(uint64_t a,
     uint64_t b) {
     value128 answer;
-#ifdef _M_ARM64
+#if defined(_M_ARM64) && !defined(__MINGW32__)
     // ARM64 has native support for 64-bit multiplications, no need to emulate
+    // (MSVC's __umulh). As in upstream fast_float, MinGW on ARM64 (which also
+    // defines _M_ARM64 but has no __umulh) uses the __uint128_t path below.
     answer.high = __umulh(a, b);
     answer.low = a * b;
 #elif defined(FASTFLOAT_32BIT) || (defined(_WIN64) && !defined(__clang__))
