#!/bin/sh
# Download and verify the pinned LadybugDB C library for this platform.

set -eu

LBUG_VERSION=$(tr -d '[:space:]' < tools/lbug_version)
ARCH=$(uname -m)
OS=$(uname -s)

case "${OS}-${ARCH}" in
  Darwin-arm64|Darwin-aarch64)
    ARTIFACT="liblbug-static-osx-arm64.tar.gz"
    ;;
  Darwin-x86_64)
    ARTIFACT="liblbug-static-osx-x86_64.tar.gz"
    ;;
  Linux-x86_64|Linux-amd64)
    ARTIFACT="liblbug-static-linux-x86_64-compat.tar.gz"
    ;;
  Linux-aarch64|Linux-arm64)
    ARTIFACT="liblbug-static-linux-aarch64-compat.tar.gz"
    ;;
  *)
    echo "configure: ERROR: unsupported platform ${OS}-${ARCH}." >&2
    exit 1
    ;;
esac

EXPECTED_SHA=$(awk -v artifact="$ARTIFACT" '$1 == artifact { print $2 }' tools/lbug_checksums)
if [ -z "$EXPECTED_SHA" ]; then
  echo "configure: ERROR: no SHA-256 recorded for ${ARTIFACT}." >&2
  exit 1
fi

VENDOR_INC="$(pwd)/src/vendor/include"
VENDOR_LIB="$(pwd)/src/vendor/lib"
LBUG_HEADER="${VENDOR_INC}/lbug.h"
LBUG_LIB="${VENDOR_LIB}/liblbug.a"
VERSION_MARKER="${VENDOR_LIB}/ladybugdb-version"
mkdir -p "$VENDOR_INC" "$VENDOR_LIB"

VENDORED_VERSION=""
if [ -f "$VERSION_MARKER" ]; then
  VENDORED_VERSION=$(tr -d '[:space:]' < "$VERSION_MARKER")
fi

if [ -f "$LBUG_HEADER" ] && [ -f "$LBUG_LIB" ] && [ "$VENDORED_VERSION" = "$LBUG_VERSION" ]; then
  echo "configure: using LadybugDB v${LBUG_VERSION} artifacts already in src/vendor."
else
  URL="https://github.com/LadybugDB/ladybug/releases/download/v${LBUG_VERSION}/${ARTIFACT}"
  DOWNLOAD_DIR=$(mktemp -d)
  trap 'rm -rf "$DOWNLOAD_DIR"' EXIT HUP INT TERM
  ARCHIVE="${DOWNLOAD_DIR}/${ARTIFACT}"

  echo "configure: downloading ${URL}"
  curl -fL --retry 3 --connect-timeout 30 --max-time 600 "$URL" -o "$ARCHIVE"

  if command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA=$(shasum -a 256 "$ARCHIVE" | awk '{ print $1 }')
  elif command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA=$(sha256sum "$ARCHIVE" | awk '{ print $1 }')
  else
    echo "configure: ERROR: shasum or sha256sum is required to verify LadybugDB." >&2
    exit 1
  fi
  if [ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]; then
    echo "configure: ERROR: SHA-256 mismatch for ${ARTIFACT}." >&2
    echo "configure: expected ${EXPECTED_SHA}, got ${ACTUAL_SHA}." >&2
    exit 1
  fi

  tar -xzf "$ARCHIVE" -C "$DOWNLOAD_DIR"
  HEADER_SOURCE=$(find "$DOWNLOAD_DIR" -name lbug.h | head -n 1)
  LIB_SOURCE=$(find "$DOWNLOAD_DIR" -name liblbug.a | head -n 1)
  if [ -z "$HEADER_SOURCE" ] || [ -z "$LIB_SOURCE" ]; then
    echo "configure: ERROR: ${ARTIFACT} did not contain lbug.h and liblbug.a." >&2
    exit 1
  fi

  cp "$HEADER_SOURCE" "$LBUG_HEADER"
  cp "$LIB_SOURCE" "$LBUG_LIB"
  printf '%s\n' "$LBUG_VERSION" > "$VERSION_MARKER"

  echo "configure: verified and installed LadybugDB v${LBUG_VERSION}."
fi

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists openssl; then
  OPENSSL_LIBS=$(pkg-config --libs openssl)
else
  OPENSSL_LIBS='-lssl -lcrypto'
fi

sed -e "s|@VENDOR_INC@|${VENDOR_INC}|g" \
    -e "s|@LBUG_LIB@|${LBUG_LIB}|g" \
    -e "s|@OPENSSL_LIBS@|${OPENSSL_LIBS}|g" \
    src/Makevars.in > src/Makevars

echo "configure: wrote src/Makevars for ${OS}-${ARCH}."
